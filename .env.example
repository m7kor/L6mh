# ── Required ──
DISCORD_TOKEN=
CLIENT_ID=
YOUTUBE_API_KEY=
CHANNEL_ID=

# ── Optional: Discord ──
# Server ID for instant slash-command registration while testing.
# Leave empty to register globally (~1hr delay).
GUILD_ID=

# ── Optional: Playback ──
# Default volume 0-200. Default: 100
DEFAULT_VOLUME=100
# Per-user command cooldown in ms. Default: 8000
COMMAND_COOLDOWN_MS=8000

# ── Optional: Audio ──
# PoT provider base URL (for yt-dlp bot detection bypass).
# The PoT provider must run on the server as a separate service.
POT_PROVIDER_URL=none

# Multiple PoT providers (comma-separated) — system auto-switches on failure.
# If set, overrides POT_PROVIDER_URL. Example: http://127.0.0.1:4416,http://backup:4416
POT_PROVIDER_URLS=

# Equal-power crossfade length, in seconds, applied at every track boundary.
# This is what removes the gap between tracks. Set to 0 for a plain hard switch.
# Tracks shorter than 20s are never crossfaded.
CROSSFADE_SECONDS=4

# ── Optional: Authentication ──
# Cookie source for yt-dlp YouTube authentication.
# "none" = use cookies.txt file (default, recommended for servers).
# "edge" / "chrome" / "firefox" = extract from local browser (local dev only).
COOKIE_BROWSER=none

# ── Optional: Dashboard ──
# Set to enable the web dashboard. Dashboard is disabled if unset.
STATUS_PORT=3333
# Bind address for dashboard. Default: 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to allow remote access (only with DASHBOARD_TOKEN set!).
STATUS_HOST=127.0.0.1
# REQUIRED for dashboard: Bearer token for API auth. All API endpoints
# (status, command, play, skip, volume, pause, resume, etc.) require:
#   Authorization: Bearer <DASHBOARD_TOKEN>
# Dashboard will NOT start if this is empty.
DASHBOARD_TOKEN=

# Comma-separated list of browser origins allowed to call the public
# endpoints (/api/public, /api/activity/state) — e.g. https://radio.example.com
# Unset means cross-origin requests are refused. It used to default to "*",
# which exposed now-playing titles, play history, uptime, the leaderboard and
# the invite URL to any origin.
CORS_ORIGINS=

# Number of proxy hops in front of the dashboard, used to resolve the real
# client IP for rate limiting. Behind one reverse proxy this should be 1.
# Set to false if the dashboard is exposed directly. With this misconfigured,
# every client shares a single rate-limit bucket.
TRUST_PROXY=1

# Optional: Public page join button. A validated https invite link shown on
# /live as "استمع عبر ديسكورد". Only discord.gg/{code} or
# discord.com/invite/{code} are accepted; anything else is ignored.
# Leave empty to hide the button (a note is shown instead).
DISCORD_INVITE_URL=

# ── Optional: Monitoring ──
# Discord webhook URL for ops notifications (errors, cookie expiry alerts, etc.)
HEALTH_WEBHOOK_URL=
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ── Optional: Sound Effects ──
# Auto-play random jingle clips between tracks.
SOUND_EFFECTS_ENABLED=false
SOUND_EFFECTS_MIN_MINUTES=8
SOUND_EFFECTS_MAX_MINUTES=20
# How long a jingle may run before it is abandoned, in ms.
# This is a safety net, not a tuning knob: a clip whose player never reaches
# Idle would otherwise block playback start forever, and leave the connection
# subscribed to the jingle instead of the radio. Default: 30000
SOUND_TIMEOUT_MS=30000

# ── Optional: Logging ──
# Set to "json" for structured JSON logs (recommended for production).
LOG_FORMAT=

# ── Optional: Heartbeat ──
# Heartbeat file write interval in ms.
HEARTBEAT_INTERVAL_MS=

# ── Optional: Command Permissions ──
# Discord role ID required to use playback commands. Leave empty to allow all members.
DJ_ROLE_ID=
