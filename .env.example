# Discord bot token (from Developer Portal)
DISCORD_TOKEN=

# Discord application/client ID (from Developer Portal → General Information)
CLIENT_ID=

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# YouTube channel ID
CHANNEL_ID=

# Voice channel ID to auto-join on startup (optional — bot won't auto-join if empty)
VOICE_CHANNEL_ID=

# Optional: a Discord webhook URL for ops notifications
HEALTH_WEBHOOK_URL=

# Optional: server ID for instant slash-command updates while testing
GUILD_ID=

# Optional: default playback volume in percent (0-200). Defaults to 100.
DEFAULT_VOLUME=100
