# Discord bot token (from Developer Portal)
DISCORD_TOKEN=

# Discord application/client ID (from Developer Portal → General Information)
CLIENT_ID=

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# YouTube channel ID (for the "latest" command)
CHANNEL_ID=

# Optional: a Discord webhook URL for ops notifications — startup, crashes,
# repeated voice-rejoin trouble, and YouTube quota exhaustion. Create one in
# a private channel: Channel Settings → Integrations → Webhooks → New Webhook.
# Leave empty to disable (the bot works exactly the same either way).
HEALTH_WEBHOOK_URL=

# Optional: server ID for instant slash-command updates while testing
# (right-click your server icon → Copy Server ID, needs Developer Mode on).
# Leave empty to register commands globally (works everywhere, ~1hr delay).
GUILD_ID=

# Optional: default playback volume in percent (0-200). Defaults to 100.
DEFAULT_VOLUME=100

# Optional: how many upcoming videos to pre-fetch/show in /queue. Defaults to 5.
QUEUE_PREVIEW_SIZE=5

# Optional: ambient soundboard settings. With files in /sounds, the bot
# automatically plays a random one on an interval between these two values
# (in minutes) while the radio is running — no command needed.
SOUND_EFFECTS_ENABLED=true
SOUND_EFFECTS_MIN_MINUTES=8
SOUND_EFFECTS_MAX_MINUTES=20
