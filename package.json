{
  "name": "discord-yt-audio-bot",
  "version": "1.1.0",
  "description": "Discord bot that plays YouTube audio in voice channels 24/7 with web dashboard",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --test src/utils/tests.test.js",
    "pm2:start": "pm2 start src/index.js --name yt-audio-bot",
    "pm2:restart": "pm2 restart yt-audio-bot",
    "pm2:stop": "pm2 stop yt-audio-bot",
    "pm2:logs": "pm2 logs yt-audio-bot",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.16.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "opusscript": "^0.0.8",
    "prism-media": "^1.0.5",
    "sodium-native": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^10.1.0",
    "typescript": "^5.9.0"
  }
}
