{
  "name": "discord-yt-audio-bot",
  "version": "1.1.0",
  "description": "Discord bot that plays YouTube audio in voice channels 24/7 with web dashboard",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "deploy": "tsx src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test node --import tsx --test src/utils/tests.test.ts",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:stop": "pm2 stop yt-audio-bot",
    "pm2:logs": "pm2 logs yt-audio-bot",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@napi-rs/canvas": "^1.0.9",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "opusscript": "^0.0.8",
    "prism-media": "^1.0.5",
    "sodium-native": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
